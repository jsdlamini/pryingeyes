# PryingEyes configuration. `./start.sh setup` creates .env from this file and fills in the
# generated secrets. Never commit .env (it's in .gitignore) and keep it private: chmod 600 .env.

# =====================================================================================
#  YOUR SETTINGS: fill these in. Each service has a development stand-in, so the app runs
#  before you've added any keys. Calls and chats run inside PryingEyes, and no text messages
#  are sent: email is the only outside service needed. `./start.sh setup` keeps this block when
#  it rebuilds .env; `./start.sh check` shows what's in use. Restart the app after editing.
# =====================================================================================

# --- Site address ----------------------------------------------------------------------
# The public web address of this PryingEyes server: the base of every link it sends
# (email confirmations, /t/<code> contact links, /g/<invite> group invites, the QR codes).
# This file is set up for the live server. On a laptop, ./start.sh setup switches its copy to
# APP_ENV=development and APP_URL=http://localhost:3000 automatically.
# development = local stand-ins allowed (email outbox, built-in human check)
# staging/production = Resend, Turnstile and an https address are required
APP_ENV=production
APP_URL=https://pryingeyes.idealsoftwaresolutions.com
# Passkey domain. Leave empty to use APP_URL's host (pryingeyes.idealsoftwaresolutions.com). Only set it to share
# passkeys with a parent domain (idealsoftwaresolutions.com). Changing it later invalidates
# existing passkeys.
RP_ID=

# --- First administrators --------------------------------------------------------------
# Your email address(es), comma-separated. When an account with one of these emails confirms
# its address, it becomes an admin automatically: no server command needed.
ADMIN_EMAILS=

# --- Email: Resend (https://resend.com) ------------------------------------------------
# Sign-up confirmation links, the 6-digit codes callers confirm on Tier 2/3 codes, and alerts.
# outbox = emails appear at http://localhost:3000/dev/outbox (development only)
# resend = send real emails (required for staging/production)
EMAIL_PROVIDER=outbox
# API key from https://resend.com/api-keys (starts with re_). "Sending access" is enough.
RESEND_API_KEY=
# Sender, on a domain verified in Resend (Domains > Add domain: SPF + DKIM records).
# The test sender below only delivers to the email you log in to Resend with,
# and isn't allowed in staging/production.
EMAIL_FROM="PryingEyes <onboarding@resend.dev>"
# Optional reply-to address (a monitored inbox)
EMAIL_REPLY_TO=

# --- Human check: Cloudflare Turnstile (https://dash.cloudflare.com > Turnstile) -------
# dev = built-in "I'm a person" checkbox (development only); turnstile = Cloudflare
# Add localhost and your server's domain to the widget's hostnames.
CAPTCHA_PROVIDER=dev
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Region ----------------------------------------------------------------------------
# Default country for the optional "show my number" field (ISO code: SZ, ZA, BW, ...)
DEFAULT_COUNTRY=SZ

# =====================================================================================
#  SERVER SETTINGS: the defaults work locally. For a server, see docs/DEPLOY-SUBDOMAIN.md.
# =====================================================================================

RP_NAME=PryingEyes

# --- Database and cache ------------------------------------------------------
# Empty = built in: PostgreSQL runs inside the website (files in DATA_DIR/postgres) and the
# cache lives in memory. Nothing else to install. Only the website may open the built-in
# database; back up DATA_DIR together with this .env (its keys unlock the data).
# Set both to use separate PostgreSQL and Redis servers, e.g. to run several copies of the app:
#   DATABASE_URL=postgresql://pryingeyes:secret@127.0.0.1:5432/pryingeyes
#   REDIS_URL=redis://127.0.0.1:6379/0
DATABASE_URL=
REDIS_URL=
DATA_DIR=./var/data
# on = the website runs its housekeeping jobs itself (expiring codes and messages, missed calls).
# off = only if you run `npm run jobs` as a separate process.
BACKGROUND_JOBS=on

# --- Keys (generated) -------------------------------------------------------
KEY_PROVIDER=local
MASTER_KEK=REPLACE_ME
MASTER_KEK_VERSION=1
# Previous KEKs during rotation, JSON: {"1":"base64key"}
KEK_PREVIOUS={}
TOKEN_PEPPER=REPLACE_ME
BLIND_INDEX_KEY=REPLACE_ME
SECRETS_HMAC_KEY=REPLACE_ME
EVIDENCE_SIGNING_KEY=REPLACE_ME
# Shared with coturn (docker compose passes it as --static-auth-secret)
TURN_SECRET=REPLACE_ME

# --- In-app calls over data (WebRTC through our own TURN relay) --------------
# The live server's relay (coturn, started by docker compose). ./start.sh setup points a
# laptop's copy at its own relay instead.
TURN_URLS=turn:pryingeyes.idealsoftwaresolutions.com:3478?transport=udp,turns:pryingeyes.idealsoftwaresolutions.com:5349?transport=tcp
# true = always relay, which hides both people's IP addresses (required in production)
CALL_RELAY_ONLY=true
# How long an in-app call rings before it becomes a missed call
CALL_RING_SECONDS=45

# --- Phone app (Expo) --------------------------------------------------------
# Development only: lets the app's web build (npx expo start --web) call this server.
# Phones and emulators don't need this. Must be empty in staging/production.
MOBILE_DEV_ORIGINS=

# --- Phone app links (only for store/EAS builds; see docs/DEPLOY-SUBDOMAIN.md §6) -------
# Lets https://<APP_URL>/t/<code> and /g/<invite> open the app directly.
ANDROID_PACKAGE=com.pryingeyes.app
# Signing-certificate SHA-256 fingerprint(s), e.g. AA:BB:CC:... (comma-separated)
ANDROID_CERT_SHA256=
IOS_BUNDLE_ID=com.pryingeyes.app
# 10-character Apple team ID
IOS_TEAM_ID=
# Where the website's "Get the app" link points (store page or APK link)
APP_DOWNLOAD_URL=

# --- Policy defaults (rule 7) -----------------------------------------------
TRUST_PROXY_HOPS=1
GATE_FLOOR_MS=200
RL_IP_PER_HOUR=30
# New accounts per network address per hour (raise it if many people share one connection)
RL_SIGNUP_PER_IP_HOUR=30
RL_CALLER_PER_DAY=10
RL_CALLER_TOKEN_PER_DAY=3
RL_TOKEN_PER_DAY=50
RL_FAILS_BEFORE_LOCK=5
RL_FAIL_WINDOW_SEC=900
RL_LOCK_BASE_SEC=3600
RL_LOCK_MAX_SEC=86400
RL_TOKEN_FAILS_BEFORE_FREEZE=10
RL_TOKEN_FAIL_WINDOW_SEC=3600
TIER2_DAILY_CAP=3
MAX_TOKENS_PER_NUMBER=10

AUDIT_ANCHOR_DIR=./var/anchors
LOG_LEVEL=info
# LOG_FILE=./var/log/app.log

# --- Server deployment (docker compose) --------------------------------------
# --- Docker production (docker-compose.prod.yml) ------------------------------
# The call relay's hostname: a DNS-only (grey cloud) record pointing straight at the server,
# because Cloudflare's proxy can't carry the relay's UDP traffic. TURN_URLS above must use it.
TURN_HOST=
# Only if the server is behind NAT: its public IP (or "public-ip/private-ip").
TURN_EXTERNAL_IP=
# Website port on 127.0.0.1 that your reverse proxy forwards to.
PE_PORT=3100

# Local ports, only on 127.0.0.1. Change them if other apps on the server already use these.
# PE_DB_PORT=5433
# PE_REDIS_PORT=6380
# Production call relay: TLS config and the server's certificates (see docs/DEPLOY-SUBDOMAIN.md)
TURN_CONFIG=./docker/turnserver.prod.conf
TURN_CERTS=/etc/letsencrypt
