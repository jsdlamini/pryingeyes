# ─── YOUR SETTINGS ───────────────────────────────────────────────────────────
# The site's public address: the base of every link sent by email or shown as a
# QR code, and the origin allowed by the same-origin check and passkeys.
# In production this must be https and your real domain.
APP_ENV=production
APP_URL=https://pryingeyes.idealsoftwaresolutions.com

# Comma-separated. Any account that confirms an email on this list becomes an
# admin automatically (audited).
ADMIN_EMAILS=

# ─── DATABASES (optional) ────────────────────────────────────────────────────
# Empty DATABASE_URL: the built-in PostgreSQL (PGlite) in DATA_DIR is used.
# Empty REDIS_URL: an in-memory store inside the website is used (rate limits
# and call signalling reset when it restarts).
DATABASE_URL=
REDIS_URL=
DATA_DIR=./var/data

# ─── BACKGROUND JOBS ─────────────────────────────────────────────────────────
# on: the website expires codes, deletes disappearing messages and notices
# missed calls by itself. off: run `npm run jobs` as a separate process
# (needs DATABASE_URL).
BACKGROUND_JOBS=on

# ─── LOCALE ──────────────────────────────────────────────────────────────────
# Country assumed for phone numbers typed without a + prefix.
DEFAULT_COUNTRY=SZ

# ─── EMAIL (Resend) ──────────────────────────────────────────────────────────
# outbox: nothing is sent; read mail at /dev/outbox while developing.
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM=PryingEyes <no-reply@pryingeyes.idealsoftwaresolutions.com>
EMAIL_REPLY_TO=

# ─── HUMAN CHECK (Cloudflare Turnstile) ──────────────────────────────────────
CAPTCHA_PROVIDER=dev
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ─── IN-APP CALLS (TURN relay) ───────────────────────────────────────────────
TURN_URLS=
TURN_SECRET=
CALL_RELAY_ONLY=false
CALL_RING_SECONDS=45

# ─── SECRETS (filled in by the prepare script on first run — do not hand-edit) ─
MASTER_KEK=REPLACE_ME
MASTER_KEK_VERSION=1
TOKEN_PEPPER=REPLACE_ME
BLIND_INDEX_KEY=REPLACE_ME
SECRETS_HMAC_KEY=REPLACE_ME
EVIDENCE_SIGNING_KEY=REPLACE_ME
KEY_PROVIDER=local
# KEK_PREVIOUS: only used when rotating MASTER_KEK; JSON like {"1":"<base64>"}. Leave unset otherwise.

# ─── SERVER ──────────────────────────────────────────────────────────────────
TRUST_PROXY_HOPS=1
AUDIT_ANCHOR_DIR=./var/anchors
LOG_LEVEL=info
LOG_FILE=
