    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.15",
    "next": "^15.5.28",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
