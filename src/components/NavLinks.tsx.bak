"use client";
import Link from "next/link";
import { usePathname } from "next/navigation";
import { useCallback, useEffect, useRef, useState } from "react";
import { api } from "./api";
import { Icon, type IconName } from "./Icon";
import { ThemeToggle } from "./ThemeToggle";
import { t } from "@/i18n";

type Note = { id: string; kind: string; title: string; body: string; link: string | null; readAt: string | null; createdAt: string };

/** Close a dropdown on outside click or Escape. */
function useDismiss(onClose: () => void) {
  const ref = useRef<HTMLDivElement>(null);
  useEffect(() => {
    const down = (e: MouseEvent) => { if (ref.current && !ref.current.contains(e.target as Node)) onClose(); };
    const key = (e: KeyboardEvent) => { if (e.key === "Escape") onClose(); };
    document.addEventListener("mousedown", down);
    document.addEventListener("keydown", key);
    return () => { document.removeEventListener("mousedown", down); document.removeEventListener("keydown", key); };
  }, [onClose]);
  return ref;
}

export function NavLinks({ handle, moderator, admin }: { handle: string; moderator: boolean; admin: boolean }) {
  const path = usePathname();
  const [unread, setUnread] = useState(0);
  const [chats, setChats] = useState(0);
  const [notes, setNotes] = useState<Note[] | null>(null);
  const [menu, setMenu] = useState(false);       // mobile drawer
  const [bell, setBell] = useState(false);       // notifications panel
  const [acct, setAcct] = useState(false);       // account panel
  const bellRef = useDismiss(() => setBell(false));
  const acctRef = useDismiss(() => setAcct(false));

  const refresh = useCallback(() => {
    if (document.visibilityState !== "visible") return;
    api("/api/notifications").then((r) => { setUnread(r.unread); setChats(r.chatsUnread ?? 0); }).catch(() => undefined);
  }, []);
  useEffect(() => {
    refresh();
    const id = setInterval(refresh, 20000);
    document.addEventListener("visibilitychange", refresh);
    return () => { clearInterval(id); document.removeEventListener("visibilitychange", refresh); };
  }, [refresh, path]);

  // Route change closes everything.
  useEffect(() => { setMenu(false); setBell(false); setAcct(false); }, [path]);

  async function openBell() {
    const next = !bell;
    setBell(next); setAcct(false);
    if (next) {
      try {
        const r = await api("/api/notifications");
        setNotes(r.notifications); setUnread(r.unread);
        if (r.unread > 0) { await api("/api/notifications", { method: "POST" }); setUnread(0); }
      } catch { setNotes([]); }
    }
  }
  async function signOut() {
    await fetch("/api/auth/logout", { method: "POST" });
    window.location.href = "/";
  }

  const current = (href: string) => path === href || (href !== "/groups" && path.startsWith(href));
  const link = (href: string, label: string, icon: IconName, extra?: React.ReactNode) => (
    <Link href={href} aria-current={current(href) ? "page" : undefined}>
      <Icon name={icon} size={16} />{label}{extra}
    </Link>
  );
  const badge = (n: number, label: string) => n ? <span className="badge" aria-label={`${n} ${label}`}>{n > 9 ? "9+" : n}</span> : null;
  const chatsBadge = (n: number) => n ? <span className="badge" aria-label={`${n} new`}>{n > 9 ? "9+" : n}</span> : null;

  return (
    <>
      <button type="button" className="menu-toggle" aria-expanded={menu} aria-label={menu ? "Close menu" : "Open menu"} onClick={() => setMenu((o) => !o)}>
        <Icon name={menu ? "x" : "menu"} size={20} />
      </button>

      <nav className={`nav collapsible${menu ? " open" : ""}`} aria-label="Main">
        {/* Social cluster */}
        <span className="nav-group">
          {link("/groups", "Feed", "home")}
          {link("/people", "People", "people")}
          {link("/chats", t("nav.chats"), "chat", chatsBadge(chats))}
          {link("/dashboard", "Codes", "shield")}
        </span>
        <span className="spacer" />
        <span className="nav-right">
          <Link href="/dashboard/requests" className="hide-sm" aria-current={current("/dashboard/requests") ? "page" : undefined}>
            <Icon name="inbox" size={16} />{t("nav.requests")}
          </Link>

          {/* Notifications */}
          <span style={{ position: "relative" }} ref={bellRef}>
            <button type="button" className={`iconbtn plain${bell ? " on" : ""}`} aria-expanded={bell} aria-haspopup="true"
              aria-label={`Notifications${unread ? `, ${unread} unread` : ""}`} title="Notifications" onClick={openBell}>
              <Icon name="bell" size={19} />{badge(unread, "unread")}
            </button>
            {bell && (
              <div className="pop" role="region" aria-label="Notifications">
                <h3>Notifications</h3>
                {!notes || notes.length === 0 ? <p className="empty-note">Nothing yet. Requests, chats and alerts land here.</p> : notes.slice(0, 8).map((n) => (
                  <Link key={n.id} href={n.link ?? "/dashboard"} onClick={() => setBell(false)}>
                    {!n.readAt && <span className="unread-dot" aria-label="Unread" />}
                    <span style={{ minWidth: 0 }}>
                      <b style={{ display: "block", fontSize: ".87rem" }}>{n.title}</b>
                      <span className="tiny muted" style={{ display: "block", overflow: "hidden", textOverflow: "ellipsis" }}>{n.body}</span>
                    </span>
                    <span className="when">{new Date(n.createdAt).toLocaleDateString(undefined, { day: "numeric", month: "short" })}</span>
                  </Link>
                ))}
                {notes && notes.length > 8 && <p className="empty-note tiny">Older alerts are in your audit trail.</p>}
              </div>
            )}
          </span>

          <ThemeToggle />

          {/* Account */}
          <span style={{ position: "relative" }} ref={acctRef}>
            <button type="button" className="account-chip" aria-expanded={acct} aria-haspopup="true" data-testid="account-menu" onClick={() => { setAcct(!acct); setBell(false); }}>
              <span className="avatar round">{handle[0].toUpperCase()}</span>
              <span className="hide-sm">@{handle}</span>
              <Icon name="chevron" size={14} />
            </button>
            {acct && (
              <div className="pop" role="region" aria-label="Account">
                <h3>@{handle}</h3>
                <Link href="/settings" onClick={() => setAcct(false)}><Icon name="settings" size={16} />{t("nav.settings")}</Link>
                <Link href="/dashboard/audit" onClick={() => setAcct(false)}><Icon name="log" size={16} />{t("nav.audit")}</Link>
                {moderator && <Link href="/moderation" onClick={() => setAcct(false)}><Icon name="flag" size={16} />{t("nav.moderation")}</Link>}
                {admin && <Link href="/admin" onClick={() => setAcct(false)}><Icon name="sliders" size={16} />{t("nav.admin")}</Link>}
                <button type="button" className="plain-item danger" onClick={signOut}><Icon name="logout" size={16} />{t("nav.signout")}</button>
              </div>
            )}
          </span>
        </span>
      </nav>
    </>
  );
}
